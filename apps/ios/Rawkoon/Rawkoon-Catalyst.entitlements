<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Push on Mac; the Mac App Store profile already carries this key. -->
    <key>com.apple.developer.aps-environment</key>
    <string>production</string>
    <!-- Mac App Store requires the app to be sandboxed (90296). -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- URLSession to the Rawkoon server + TMDB/artwork under the sandbox. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Importing an ebook/audiobook the user picks. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
