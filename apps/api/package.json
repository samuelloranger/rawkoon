{
  "name": "@rawkoon/api",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "packageManager": "bun@1.4.0",
  "module": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "test": "bun test --parallel --isolate test/ src/",
    "e2e:server": "env -u NODE_ENV bun --preload ./e2e/mocks/preload.ts ./e2e/server.ts",
    "e2e:manifest": "env -u NODE_ENV bun --preload ./e2e/mocks/preload.ts ./e2e/genManifest.ts",
    "e2e:endpoints": "env -u NODE_ENV bun --preload ./e2e/mocks/preload.ts ./e2e/run.ts",
    "db:generate": "set -a && . ../../.env && set +a && bunx prisma generate",
    "db:migrate:dev": "set -a && . ../../.env && set +a && bunx prisma migrate dev && bunx prisma generate",
    "db:migrate": "set -a && . ../../.env && set +a && bunx prisma migrate deploy",
    "db:push": "set -a && . ../../.env && set +a && bunx prisma db push && bunx prisma generate",
    "db:studio": "set -a && . ../../.env && set +a && bunx prisma studio",
    "qbittorrent:client-debug": "bun src/scripts/qbittorrentClientDebug.ts",
    "qbittorrent:request-logs": "bun src/scripts/qbittorrentRequestLogs.ts",
    "library:check-integrity": "bun --env-file=../../.env src/scripts/checkLibraryIntegrity.ts",
    "library:check-integrity:persist": "bun --env-file=../../.env src/scripts/checkLibraryIntegrity.ts --persist",
    "library:refresh-titles": "bun --env-file=../../.env src/scripts/refreshLibraryTitlesFromTmdb.ts",
    "library:refresh-titles:apply": "bun --env-file=../../.env src/scripts/refreshLibraryTitlesFromTmdb.ts --apply",
    "baseline:seed": "bun --env-file=../../.env src/scripts/seedBaseline.ts",
    "baseline:report": "bun --env-file=../../.env src/scripts/perfBaselineReport.ts",
    "rotate-secret": "bun --env-file=../../.env src/scripts/rotateSecret.ts",
    "postinstall": "prisma generate",
    "format": "biome format --write .",
    "formatCheck": "biome format .",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "e2e:diff": "bun run e2e/diff.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.3",
    "@better-auth/passkey": "1.7.3",
    "@better-auth/prisma-adapter": "1.7.3",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@hono/standard-validator": "^0.4.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@rawkoon/shared": "workspace:*",
    "better-auth": "1.7.3",
    "bullmq": "^6.3.4",
    "elysia": "^1.4.30",
    "elysia-rate-limit": "^4.6.3",
    "hono": "^4.13.7",
    "hono-rate-limiter": "^0.5.4",
    "ioredis": "^6.0.0",
    "ua-parser-js": "^2.0.10",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.4.2",
    "prisma": "7.10.0"
  }
}
