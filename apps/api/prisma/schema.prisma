generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String    @id @default(uuid())
  name                    String    @default("")
  email                   String    @unique(map: "ix_users_email")
  emailVerified           Boolean   @default(true) @map("email_verified")
  passwordHash            String?   @map("password_hash")
  isAdmin                 Boolean?  @map("is_admin")
  lastLogin               DateTime? @map("last_login")
  createdAt               DateTime? @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  lastActivity            DateTime? @map("last_activity")
  firstName               String?   @map("first_name")
  lastName                String?   @map("last_name")
  locale                  String?
  avatarUrl               String?   @map("avatar_url")
  navPosition             String?   @map("nav_position")
  dashboardConfig         Json?     @map("dashboard_config")

  notifications        Notification[]
  userSubscriptions    UserSubscription[]
  activityLogs         ActivityLog[]
  notificationChannels NotificationChannel[]
  invitationsSent      Invitation[]          @relation("InvitationInviter")
  watchlistItems       WatchlistItem[]
  discoverDismissals   DiscoverDismissal[]
  baSessions           BaSession[]
  baAccounts           BaAccount[]
  baPasskeys           BaPasskey[]
  baApiKeys            BaApiKey[]
  mediaRequests        MediaRequest[] @relation("MediaRequestRequester")
  decidedMediaRequests MediaRequest[] @relation("MediaRequestDecider")

  @@map("users")
}

model Notification {
  id                   Int       @id @default(autoincrement())
  userId               String    @map("user_id")
  title                String
  body                 String
  type                 String
  read                 Boolean   @default(false)
  readAt               DateTime? @map("read_at")
  url                  String?
  imageUrl             String?   @map("image_url")
  notificationMetadata Json?     @map("notification_metadata")
  createdAt            DateTime  @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt], map: "ix_notifications_created_at")
  @@index([userId], map: "ix_notifications_user_id")
  /// Unread badge count + unread-id sweep.
  @@index([userId, read], map: "ix_notifications_user_id_read")
  /// Paged inbox (created_at desc per user).
  @@index([userId, createdAt(sort: Desc)], map: "ix_notifications_user_id_created_at")
  @@map("notifications")
}

model Integration {
  id        Int       @id @default(autoincrement())
  type      String    @unique(map: "ix_integrations_type")
  enabled   Boolean   @default(false)
  config    Json?
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("integrations")
}

model BaApiKey {
  id                  String    @id @default(uuid())
  configId            String    @default("default") @map("config_id")
  name                String?
  start               String?
  referenceId         String    @map("reference_id")
  prefix              String?
  key                 String
  refillInterval      Int?      @map("refill_interval")
  refillAmount        Int?      @map("refill_amount")
  lastRefillAt        DateTime? @map("last_refill_at")
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(true) @map("rate_limit_enabled")
  rateLimitTimeWindow Int?      @map("rate_limit_time_window")
  rateLimitMax        Int?      @map("rate_limit_max")
  requestCount        Int       @default(0) @map("request_count")
  remaining           Int?
  lastRequest         DateTime? @map("last_request")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  permissions         String?   @db.Text
  metadata            String?   @db.Text

  user User @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([name])
  @@index([key], map: "ix_ba_api_keys_key")
  @@index([referenceId], map: "ix_ba_api_keys_reference_id")
  @@index([configId], map: "ix_ba_api_keys_config_id")
  @@map("ba_api_keys")
}

model OidcProvider {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  discoveryUrl String   @map("discovery_url")
  clientId     String   @map("client_id")
  clientSecret String   @map("client_secret")
  enabled      Boolean  @default(true)
  iconUrl      String?  @map("icon_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("oidc_providers")
}

model UserSubscription {
  id               Int       @id @default(autoincrement())
  userId           String    @map("user_id")
  subscriptionInfo String    @map("subscription_info")
  endpoint         String?
  createdAt        DateTime? @map("created_at")
  updatedAt        DateTime? @map("updated_at")
  deviceName       String?   @map("device_name")
  osName           String?   @map("os_name")
  osVersion        String?   @map("os_version")
  browserName      String?   @map("browser_name")
  browserVersion   String?   @map("browser_version")
  platform         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([endpoint], map: "ix_user_subscriptions_endpoint")
  @@index([userId], map: "ix_user_subscriptions_user_id")
  @@map("user_subscriptions")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  type      String   @db.VarChar(50)
  userId    String?  @map("user_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "ix_activity_logs_created_at")
  @@index([type], map: "ix_activity_logs_type")
  @@index([userId], map: "ix_activity_logs_user_id")
  @@map("activity_logs")
}

model Invitation {
  id         Int       @id @default(autoincrement())
  email      String
  token      String    @unique(map: "ix_invitations_token")
  status     String    @default("pending") @db.VarChar(20)
  expiresAt  DateTime  @map("expires_at")
  invitedBy  String?   @map("invited_by")
  locale     String    @default("en")
  isAdmin    Boolean   @default(false) @map("is_admin")
  createdAt  DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")

  inviter User? @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  /// The real invariant — "at most one PENDING invitation per email" — is a
  /// PARTIAL unique index Prisma cannot express, created in
  /// 20260811000000_reconcile_prod_schema_drift:
  ///   UNIQUE (email) WHERE status = 'pending'
  /// It replaced @@unique([email, status]), which also forbade a second
  /// *revoked* or *accepted* row for the same email — legitimate history that
  /// production had already accumulated. The POST /api/admin/invitations
  /// handler catches P2002 and reports "a pending invitation already exists",
  /// so it was written against exactly this constraint.
  @@index([email], map: "ix_invitations_email")
  @@map("invitations")
}

model NotificationChannel {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  type      String   @db.VarChar(20)
  label     String   @db.VarChar(100)
  config    Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_notification_channels_user_id")
  @@map("notification_channels")
}

model QbittorrentRequestLog {
  id            Int      @id @default(autoincrement())
  method        String   @db.VarChar(10)
  endpoint      String   @db.VarChar(255)
  requestPath   String   @map("request_path") @db.VarChar(512)
  statusCode    Int?     @map("status_code")
  ok            Boolean  @default(false)
  durationMs    Int      @map("duration_ms")
  responseBytes Int?     @map("response_bytes")
  authRetried   Boolean  @default(false) @map("auth_retried")
  rid           Int?
  fullUpdate    Boolean? @map("full_update")
  itemCount     Int?     @map("item_count")
  removedCount  Int?     @map("removed_count")
  errorMessage  String?  @map("error_message") @db.Text
  meta          Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "ix_qbittorrent_request_logs_created_at")
  @@index([endpoint, createdAt], map: "ix_qbittorrent_request_logs_endpoint_created_at")
  @@index([ok, createdAt], map: "ix_qbittorrent_request_logs_ok_created_at")
  @@map("qbittorrent_request_logs")
}

model WatchlistItem {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id")
  tmdbId      Int      @map("tmdb_id")
  mediaType   String   @map("media_type")
  title       String
  posterUrl   String?  @map("poster_url")
  overview    String?
  releaseYear Int?     @map("release_year")
  voteAverage Float?   @map("vote_average")
  addedAt     DateTime @default(now()) @map("added_at")

  /// Cached TMDB theatrical release date (movies only). Used for day-before reminders.
  movieReleaseDate       DateTime? @map("movie_release_date") @db.Date
  /// YYYY-MM-DD release date we already sent a day-before reminder for (movies only).
  releaseReminderSentFor String?   @map("release_reminder_sent_for") @db.VarChar(10)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType], map: "uq_watchlist_user_tmdb_type")
  @@index([userId, addedAt], map: "ix_watchlist_user_added_at")
  @@map("watchlist_items")
}

model QualityProfile {
  id                       Int      @id @default(autoincrement())
  name                     String   @unique
  minResolution            Int      @default(1080) @map("min_resolution") // 480 | 720 | 1080 | 2160
  preferredSources         String[] @map("preferred_sources")
  preferredCodecs          String[] @map("preferred_codecs")
  preferredLanguages       String[] @default([]) @map("preferred_languages")
  /// ISO 639-1 title language for indexer queries; null → en at add time.
  /// Distinct from preferredLanguages (audio flags on release names).
  preferredSearchLanguage  String?  @map("preferred_search_language")
  prioritizedTrackers      String[] @default([]) @map("prioritized_trackers")
  preferTrackerOverQuality Boolean  @default(false) @map("prefer_tracker_over_quality")
  maxSizeGb                Float?   @map("max_size_gb")
  requireHdr               Boolean  @default(false) @map("require_hdr")
  preferHdr                Boolean  @default(false) @map("prefer_hdr")
  cutoffResolution         Int?     @map("cutoff_resolution")
  minSeeders               Int      @default(0) @map("min_seeders")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  media              LibraryMedia[]
  defaultForMovieSettings MediaSettings[] @relation("DefaultMovieQualityProfile")
  defaultForShowSettings  MediaSettings[] @relation("DefaultShowQualityProfile")
  customFormats      QualityProfileCustomFormat[]
  mediaRequests      MediaRequest[]

  @@map("quality_profiles")
}

model CustomFormat {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  /// FormatCondition[] (see customFormatTypes.ts). A format MATCHES when ALL
  /// its conditions match; each condition is individually negatable.
  conditions  Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profileLinks     QualityProfileCustomFormat[]
  bookProfileLinks BookQualityProfileCustomFormat[]

  @@map("custom_formats")
}

model QualityProfileCustomFormat {
  id               Int     @id @default(autoincrement())
  qualityProfileId Int     @map("quality_profile_id")
  customFormatId   Int     @map("custom_format_id")
  score            Int     @default(0)
  required         Boolean @default(false)
  forbidden        Boolean @default(false)

  qualityProfile QualityProfile @relation(fields: [qualityProfileId], references: [id], onDelete: Cascade)
  customFormat   CustomFormat   @relation(fields: [customFormatId], references: [id], onDelete: Cascade)

  @@unique([qualityProfileId, customFormatId])
  @@index([qualityProfileId], map: "ix_qp_custom_format_profile")
  @@map("quality_profile_custom_formats")
}

model BaSession {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  providerId String?  @map("provider_id")
  userId     String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_ba_sessions_user_id")
  @@map("ba_sessions")
}

model BaAccount {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_ba_accounts_user_id")
  @@map("ba_accounts")
}

model BaVerification {
  id         String   @id @default(uuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("ba_verifications")
}

model BaPasskey {
  id           String    @id @default(uuid())
  name         String?
  publicKey    String    @map("public_key") @db.Text
  userId       String    @map("user_id")
  credentialID String    @map("credential_id")
  counter      Int
  deviceType   String    @map("device_type")
  backedUp     Boolean   @map("backed_up")
  transports   String?
  createdAt    DateTime? @map("created_at")
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([credentialID], map: "ix_ba_passkeys_credential_id")
  @@index([userId], map: "ix_ba_passkeys_user_id")
  @@map("ba_passkeys")
}

model LibraryMedia {
  id                    Int       @id @default(autoincrement())
  tmdbId                Int       @unique @map("tmdb_id")
  type                  String // "movie" | "show"
  title                 String
  sortTitle             String?   @map("sort_title")
  year                  Int?
  status                String    @default("wanted") // wanted | downloading | downloaded | skipped | returning | in_production | planned | upgrading
  tmdbStatus            String?   @map("tmdb_status")
  tmdbStatusRefreshedAt DateTime? @map("tmdb_status_refreshed_at")
  monitored             Boolean   @default(true)
  posterUrl             String?   @map("poster_url")
  overview              String?
  overrides             Json?     @map("overrides")
  originalTitle         String?   @map("original_title")
  originalLanguage      String?   @map("original_language")
  searchTitle           String?   @map("search_title")
  searchTitleLanguage   String?   @map("search_title_language")
  digitalReleaseDate    DateTime? @map("digital_release_date")
  qualityProfileId      Int?      @map("quality_profile_id")
  searchAttempts        Int       @default(0) @map("search_attempts")
  addedAt               DateTime  @default(now()) @map("added_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  /// Persisted MAX(download_history.grabbed_at); kept in sync by DB trigger.
  lastGrabbedAt         DateTime? @map("last_grabbed_at")
  /// Persisted SUM of movie + episode file sizes; 0 stored as null. DB trigger.
  totalSizeBytes        BigInt?   @map("total_size_bytes")
  /// Display title for list ORDER BY (overrides.title when set, else title).
  listTitle             String    @default("") @map("list_title")
  /// Display year for list ORDER BY (overrides.year when set, else year).
  listYear              Int?      @map("list_year")
  /// Persisted COUNT of library_episodes; null for movies. DB trigger.
  episodeCount          Int?      @map("episode_count")
  /// Persisted COUNT of downloaded library_episodes; null for movies. DB trigger.
  downloadedEpisodeCount Int?     @map("downloaded_episode_count")
  /// Persisted COUNT(DISTINCT season) of library_episodes; null for movies. DB trigger.
  seasonCount           Int?      @map("season_count")

  qualityProfile    QualityProfile?   @relation(fields: [qualityProfileId], references: [id], onDelete: SetNull)
  episodes          LibraryEpisode[]
  files             MediaFile[]       @relation("MediaFileMedia")
  downloadHistories DownloadHistory[]
  blocklistEntries  GrabBlocklist[]
  attentionAlerts   LibraryAttentionAlert[]
  mediaRequests     MediaRequest[]

  @@index([type], map: "ix_library_media_type")
  @@index([status], map: "ix_library_media_status")
  @@index([qualityProfileId], map: "ix_library_media_quality_profile_id")
  /// Speeds added_at desc pagination (recently-added / default library sort)
  @@index([addedAt], map: "ix_library_media_added_at")
  /// GIN trigram for ILIKE '%q%' title search on GET /api/library
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_library_media_title_trgm")
  @@index([lastGrabbedAt], map: "ix_library_media_last_grabbed_at")
  @@index([totalSizeBytes], map: "ix_library_media_total_size_bytes")
  @@index([listTitle], map: "ix_library_media_list_title")
  @@index([listYear], map: "ix_library_media_list_year")
  /// Dashboard upcoming: digital release window with no status filter, so
  /// ix_library_media_status cannot help. Measured 2.5ms → 0.04ms at 13k rows.
  /// NOTE: a (type, status, monitored) composite was tried and removed — the
  /// planner always preferred ix_library_media_status (status is far more
  /// selective than a two-value type), so it was pure write overhead.
  @@index([digitalReleaseDate], map: "ix_library_media_digital_release_date")
  /// GET /api/library always pairs a type filter with a sort column.
  @@index([type, addedAt], map: "ix_library_media_type_added_at")
  @@index([type, listTitle], map: "ix_library_media_type_list_title")
  @@map("library_media")
}

model LibraryEpisode {
  id             Int       @id @default(autoincrement())
  mediaId        Int       @map("media_id")
  season         Int
  episode        Int
  title          String?
  airDate        DateTime? @map("air_date") @db.Date
  status         String    @default("wanted") // wanted | downloading | downloaded | skipped | upgrading
  monitored      Boolean   @default(true)
  tmdbEpisodeId  Int?      @map("tmdb_episode_id")
  downloadedAt   DateTime? @map("downloaded_at")
  searchAttempts Int       @default(0) @map("search_attempts")

  media             LibraryMedia      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  files             MediaFile[]       @relation("MediaFileEpisode")
  downloadHistories DownloadHistory[]
  blocklistEntries  GrabBlocklist[]
  attentionAlerts   LibraryAttentionAlert[]

  @@unique([mediaId, season, episode])
  @@index([mediaId], map: "ix_library_episodes_media_id")
  /// Cron sweeps: wanted+monitored episodes whose air date has passed.
  @@index([status, monitored, airDate], map: "ix_library_episodes_status_monitored_air_date")
  /// Dashboard upcoming: air-date window with no status filter.
  @@index([airDate], map: "ix_library_episodes_air_date")
  /// NOTE: a (media_id, season, status) composite was tried and removed — it
  /// made per-season lookups SLOWER (0.03ms → 0.58ms), because the planner
  /// chose a wide index-only scan over it instead of the better plan available
  /// from @@unique([mediaId, season, episode]) + the status index above.
  @@map("library_episodes")
}

model DownloadHistory {
  id                         Int       @id @default(autoincrement())
  mediaId                    Int?      @map("media_id")
  episodeId                  Int?      @map("episode_id")
  releaseTitle               String    @map("release_title")
  indexer                    String?
  torrentHash                String?   @map("torrent_hash")
  downloadUrl                String?   @map("download_url")
  qualityParsed              Json?     @map("quality_parsed")
  grabbedAt                  DateTime  @default(now()) @map("grabbed_at")
  completedAt                DateTime? @map("completed_at")
  failed                     Boolean   @default(false)
  failReason                 String?   @map("fail_reason")
  isUpgrade                  Boolean   @default(false) @map("is_upgrade")
  /// Local AI selected this release (RSS auto-grab or future AI grab flows)
  aiPicked                   Boolean   @default(false) @map("ai_picked")
  /// Season targeted by a season-pack grab; null for movies and single episodes.
  /// Part of the grab-target key enforced by ux_download_history_active_target —
  /// without it, two packs for different seasons of one show (both
  /// episode_id = null) would look like the same target.
  season                     Int?
  /// Set when post-processing fails after the torrent completed
  postProcessError           String?   @map("post_process_error") @db.Text
  /// Final library path after successful post-processing
  postProcessDestinationPath String?   @map("post_process_destination_path") @db.Text
  /// Book grab target. Exactly one of media_id / book_edition_id is set,
  /// enforced by a CHECK constraint. The one-active-grab-per-target rule is
  /// enforced by a SECOND partial unique index, disjoint from the media one:
  ///   UNIQUE (book_edition_id)
  ///     WHERE completed_at IS NULL AND failed = false
  ///       AND book_edition_id IS NOT NULL
  /// Disjoint predicates mean the existing media index — and grabRelease's
  /// P2002 race-close that depends on it — keep working verbatim.
  bookEditionId              Int?      @map("book_edition_id")

  media       LibraryMedia?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  episode     LibraryEpisode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  bookEdition BookEdition?    @relation(fields: [bookEditionId], references: [id], onDelete: SetNull)

  @@index([torrentHash], map: "ix_download_history_torrent_hash")
  @@index([bookEditionId], map: "ix_download_history_book_edition_id")
  @@index([mediaId], map: "ix_download_history_media_id")
  @@index([episodeId], map: "ix_download_history_episode_id")
  /// Speeds MAX(grabbed_at) / latest-grab lookups per media (library list sort)
  @@index([mediaId, grabbedAt(sort: Desc)], map: "ix_download_history_media_id_grabbed_at")
  /// The active-download poll (every ~20s) is served by a PARTIAL index that
  /// Prisma cannot express, created in the 20260810120000_query_performance
  /// migration: (grabbed_at) WHERE completed_at IS NULL AND failed = false.
  /// Do not add a plain (completed_at, failed) index here — measured at 47k
  /// rows it was 12.6ms vs 0.014ms for the partial one, because the planner
  /// preferred the grabbed_at sort index and filtered 44k rows away.
  /// Prisma ignores partial indexes in drift detection, so it survives
  /// `prisma migrate dev` (verified).
  /// At most one ACTIVE grab per target is enforced by a PARTIAL UNIQUE index
  /// Prisma cannot express, created in
  /// 20260819000000_prevent_duplicate_active_grabs:
  ///   UNIQUE (media_id, COALESCE(episode_id,-1), COALESCE(season,-1))
  ///   WHERE completed_at IS NULL AND failed = false AND media_id IS NOT NULL
  /// grabRelease depends on it: it pre-checks for an active row for a clear
  /// rejection reason, then catches P2002 to close the check-then-insert race
  /// (two crons firing on the same tick is what made this necessary).
  /// History list (grabbed_at desc pagination) + attention candidate windows.
  @@index([grabbedAt(sort: Desc)], map: "ix_download_history_grabbed_at")
  @@index([failed, grabbedAt(sort: Desc)], map: "ix_download_history_failed_grabbed_at")
  @@map("download_history")
}

/// Open alerts are created by hourly cron from library grab/download conditions; one open row per (media, scope, kind).
///
/// That "one open row" rule is enforced by a PARTIAL unique index Prisma cannot
/// express, created in 20260811000000_reconcile_prod_schema_drift:
///   UNIQUE (media_id, kind, scope_type, COALESCE(episode_id,-1), COALESCE(season,-1))
///   WHERE status = 'open'
/// libraryAttentionSync's upsert loop depends on it: it catches P2002 and falls
/// back to find + update. Until that migration the index existed only on one
/// production database and was absent from every fresh install.
model LibraryAttentionAlert {
  id                    Int       @id @default(autoincrement())
  mediaId               Int       @map("media_id")
  /// Target episode when scope_type = episode; null for movie or season_pack
  episodeId             Int?      @map("episode_id")
  /// TV season when scope_type = season_pack; optional mirror for episode scope
  season                Int?
  scopeType             String    @map("scope_type") // movie | episode | season_pack
  kind                  String // LibraryAttentionKind
  status                String    @default("open") // open | dismissed | resolved_auto
  detail                String?   @db.Text
  downloadHistoryId     Int?      @map("download_history_id")
  searchAttempts        Int?      @map("search_attempts")
  grabbedAt             DateTime? @map("grabbed_at")
  libraryStatusSnapshot String?   @map("library_status_snapshot")
  dismissedAt           DateTime? @map("dismissed_at")
  resolvedAt            DateTime? @map("resolved_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  media   LibraryMedia    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  episode LibraryEpisode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([mediaId], map: "ix_library_attention_alert_media_id")
  @@index([status], map: "ix_library_attention_alert_status")
  @@index([episodeId], map: "ix_library_attention_alert_episode_id")
  /// GET /api/library/attention: open alerts, updated_at desc, take 200.
  @@index([status, updatedAt(sort: Desc)], map: "ix_library_attention_alert_status_updated_at")
  @@map("library_attention_alerts")
}

model GrabBlocklist {
