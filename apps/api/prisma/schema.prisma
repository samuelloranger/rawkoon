/// Singleton media / library post-processing settings (row id = 1)
model MediaSettings {
  id                      Int      @id @default(1)
  moviesLibraryPath       String?  @map("movies_library_path")
  showsLibraryPath        String?  @map("shows_library_path")
  downloadsPath           String?  @map("downloads_path")
  fileOperation           String   @default("hardlink") @map("file_operation")
  movieTemplate           String   @default("{title} ({year}) [{resolution} {source}]") @map("movie_template")
  episodeTemplate         String   @default("{show}/Season {season}/{show} - S{season:02}E{episode:02} - {title} [{resolution} {source}]") @map("episode_template")
  minSeedRatio            Float    @default(1) @map("min_seed_ratio")
  postProcessingEnabled   Boolean  @default(false) @map("post_processing_enabled")
  defaultMovieQualityProfileId Int? @map("default_movie_quality_profile_id")
  defaultShowQualityProfileId  Int? @map("default_show_quality_profile_id")
  activeIndexerManager    String?  @map("active_indexer_manager")
  downloadPollActiveSecs   Int      @default(20) @map("download_poll_active_secs")
  downloadPollIdleSecs     Int      @default(1800) @map("download_poll_idle_secs")
  downloadStallTimeoutSecs Int      @default(2700) @map("download_stall_timeout_secs")
  downloadMaxAgeSecs       Int      @default(604800) @map("download_max_age_secs")
  downloadHookToken            String?   @map("download_hook_token")
  downloadHookCallbackUrl      String?   @map("download_hook_callback_url")
  downloadHookAutoConfigure    Boolean   @default(true) @map("download_hook_auto_configure")
  downloadHookLastSeenAt       DateTime? @map("download_hook_last_seen_at")
  downloadPollActiveHookedSecs Int       @default(120) @map("download_poll_active_hooked_secs")

  // ── Books ──────────────────────────────────────────
  booksLibraryPath            String?  @map("books_library_path")
  audiobooksLibraryPath       String?  @map("audiobooks_library_path")
  bookTemplate                String   @default("{author}/{title} ({year})/{title} ({year}) [{format}]") @map("book_template")
  /// Multi-track audiobooks keep their original filenames inside the rendered
  /// directory — renaming dozens of tracks risks destroying playback order.
  audiobookTemplate           String   @default("{author}/{title} ({year})/{title}") @map("audiobook_template")
  defaultBookQualityProfileId Int?     @map("default_book_quality_profile_id")
  /// Metadata source priority, highest first. Absence from this array is the
  /// disable switch — see normalizeSourceOrder in @rawkoon/shared/utils.
  bookMetadataSourceOrder String[] @default(["local", "audnexus", "googlebooks", "openlibrary"]) @map("book_metadata_source_order")
  /// Deep-link target for playback and reading. Rawkoon does not talk to the
  /// Audiobookshelf API — it only builds a URL, so an unreachable instance
  /// costs nothing but a dead link. Null means the button is not rendered.
  audiobookshelfUrl                String? @map("audiobookshelf_url")
  audiobookshelfAudiobookLibraryId String? @map("audiobookshelf_audiobook_library_id")
  audiobookshelfEbookLibraryId     String? @map("audiobookshelf_ebook_library_id")

  updatedAt               DateTime @updatedAt @map("updated_at")

  defaultMovieQualityProfile QualityProfile?    @relation("DefaultMovieQualityProfile", fields: [defaultMovieQualityProfileId], references: [id], onDelete: SetNull)
  defaultShowQualityProfile  QualityProfile?    @relation("DefaultShowQualityProfile", fields: [defaultShowQualityProfileId], references: [id], onDelete: SetNull)
  defaultBookQualityProfile BookQualityProfile? @relation("DefaultBookQualityProfile", fields: [defaultBookQualityProfileId], references: [id], onDelete: SetNull)

  @@map("media_settings")
}

/// Singleton app-wide settings (row id = 1)
model AppSettings {
  id                         Int      @id @default(1)
  countryCode                String   @default("US") @map("country_code") @db.VarChar(2)
  upcomingWindowMonths       Int      @default(12) @map("upcoming_window_months")
  upcomingLanguages          String   @default("en,fr") @map("upcoming_languages")
  /// Gates the books nav, the added indexer categories, and the books
  /// settings section. A movies-only install sees no change after upgrading.
  booksEnabled               Boolean  @default(false) @map("books_enabled")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model MediaFile {
  id             Int      @id @default(autoincrement())
  mediaId        Int?     @map("media_id")
  episodeId      Int?     @map("episode_id")
  filePath       String   @map("file_path")
  fileName       String   @map("file_name")
  sizeBytes      BigInt   @map("size_bytes")
  durationSecs   Float?   @map("duration_secs")
  releaseGroup   String?  @map("release_group")
  videoCodec     String?  @map("video_codec")
  videoProfile   String?  @map("video_profile")
  width          Int?
  height         Int?
  frameRate      Float?   @map("frame_rate")
  bitDepth       Int?     @map("bit_depth")
  videoBitrate   Int?     @map("video_bitrate")
  hdrFormat      String?  @map("hdr_format")
  resolution     Int?
  source         String?
  audioFormat    String?  @map("audio_format")
  isProper       Boolean  @default(false) @map("is_proper")
  audioTracks    Json     @default("[]") @map("audio_tracks")
  subtitleTracks Json     @default("[]") @map("subtitle_tracks")
  languageTags   String[] @default([]) @map("language_tags")
  scannedAt      DateTime @default(now()) @map("scanned_at")
  /// Filesystem device id from last successful stat (hardlink / skip-scan cache).
  /// Text, not BigInt: identity key only, and mergerfs inodes exceed signed bigint.
  fileDev        String?  @map("file_dev")
  /// Inode from last successful stat.
  fileIno        String?  @map("file_ino")
  /// mtimeMs from last successful stat — paired with sizeBytes to skip MediaInfo.
  fileMtimeMs    BigInt?  @map("file_mtime_ms")

  media   LibraryMedia?   @relation("MediaFileMedia", fields: [mediaId], references: [id], onDelete: Cascade)
  episode LibraryEpisode? @relation("MediaFileEpisode", fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([mediaId], map: "ix_media_files_media_id")
  @@index([episodeId], map: "ix_media_files_episode_id")
  @@index([filePath], map: "ix_media_files_file_path")
  @@index([languageTags], map: "ix_media_files_language_tags", type: Gin)
  @@index([fileDev, fileIno], map: "ix_media_files_file_dev_ino")
  @@map("media_files")
}

model LibraryHealthLog {
  id          Int      @id @default(autoincrement())
  status      String
  trigger     String   @default("manual")
  startedAt   DateTime @default(now()) @map("started_at")
  completedAt DateTime @map("completed_at")
  durationMs  Int      @map("duration_ms")
  summary     Json
  issues      Json
  warnings    String[] @default([])
  error       String?  @db.Text

  @@index([startedAt], map: "ix_library_health_log_started_at")
  @@map("library_health_log")
}

enum MediaRequestStatus {
  pending
  approved
  denied
  available
}

model MediaRequest {
  id               Int                @id @default(autoincrement())
  tmdbId           Int                @map("tmdb_id")
  type             String // "movie" | "show"
  title            String
  posterUrl        String?            @map("poster_url")
  year             Int?
  requestedById    String             @map("requested_by_id")
  requestedBy      User               @relation("MediaRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  status           MediaRequestStatus @default(pending)
  qualityProfileId Int?               @map("quality_profile_id")
  qualityProfile   QualityProfile?    @relation(fields: [qualityProfileId], references: [id], onDelete: SetNull)
  libraryMediaId   Int?               @map("library_media_id")
  libraryMedia     LibraryMedia?      @relation(fields: [libraryMediaId], references: [id], onDelete: SetNull)
  denyReason       String?            @map("deny_reason")
  decidedById      String?            @map("decided_by_id")
  decidedBy        User?              @relation("MediaRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now()) @map("created_at")
  decidedAt        DateTime?          @map("decided_at")

  // Single-request behavior: only one request per TMDB item can exist at a time 
  // since this is a self-hosted shared library instance.
  @@unique([tmdbId, type])
  @@index([status, createdAt(sort: Desc)], map: "ix_media_request_status_created_at")
  @@index([requestedById], map: "ix_media_request_requested_by_id")
  @@index([libraryMediaId], map: "ix_media_request_library_media_id")
  @@index([qualityProfileId], map: "ix_media_request_quality_profile_id")
  @@index([decidedById], map: "ix_media_request_decided_by_id")
  @@map("media_requests")
}

model DiscoverDismissal {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  tmdbId    Int      @map("tmdb_id")
  mediaType String   @map("media_type")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType], map: "uq_discover_dismissal_user_tmdb_type")
  @@index([userId], map: "ix_discover_dismissals_user_id")
  @@map("discover_dismissals")
}

// ─── Books / Audiobooks ──────────────────────────────────────────────────────
// A LibraryBook is exactly one Google Books volume. A translation and its
// original are two independent rows, each carrying the title trackers use, so
// the stored title is always the search term (no searchTitle indirection like
// LibraryMedia needs). Publisher printings are deliberately not modeled —
// that is what keeps (book_id, kind) a valid edition key.
model LibraryBook {
  id             Int     @id @default(autoincrement())
  googleVolumeId String  @unique @map("google_volume_id")
  isbn13         String? @map("isbn13")
  title          String
  sortTitle      String? @map("sort_title")
  subtitle       String?
  overview       String?
  coverUrl       String? @map("cover_url")
  /// Trigger-maintained cache of BookAuthor rows with role = 'author'.
  /// Feeds list queries, indexer query building, and the reject filter.
  authors        String[] @default([])
  /// ISO 639-1. A property of the book, not the edition: "the French ebook"
  /// and "the English ebook" are editions of two different books.
  language       String   @default("en")
  publishedYear  Int?     @map("published_year")
  seriesName     String?  @map("series_name")
  /// Float because half-books exist ("Book 4.5").
  seriesPosition Float?   @map("series_position")
  /// Merged from the source chain. Book-level; BookEdition.narrators stays as
  /// the local-file value, which is what the "local" source contributes.
  narrators      String[] @default([])
  /// The winning source's taxonomy, untranslated. Audible's French genres and
  /// Open Library's English subjects are never unioned — that yields a
  /// bilingual mess — so this is one source's array, whole.
  genres         String[] @default([])
  publisher      String?
  pageCount      Int?     @map("page_count")
  /// Full date when a source supplies one. publishedYear is kept: list
  /// sorting (listYear) already depends on it.
  publishedDate  DateTime? @map("published_date")
  rating         Float?
  ratingCount    Int?     @map("rating_count")
  overrides      Json?
  /// Display title for list ORDER BY (overrides.title when set, else title).
  listTitle      String   @default("") @map("list_title")
  listYear       Int?     @map("list_year")
  addedAt        DateTime @default(now()) @map("added_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  editions    BookEdition[]
  authorLinks BookAuthor[]
  externalIds    BookExternalId[]
  metadataFields BookMetadataField[]

  @@index([addedAt], map: "ix_library_books_added_at")
  @@index([listTitle], map: "ix_library_books_list_title")
  @@index([listYear], map: "ix_library_books_list_year")
  @@index([language], map: "ix_library_books_language")
  /// GIN trigram for ILIKE '%q%' title search on GET /api/books
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_library_books_title_trgm")
  @@index([authors], map: "ix_library_books_authors", type: Gin)
  @@map("library_books")
}

model BookEdition {
  id                   Int     @id @default(autoincrement())
  bookId               Int     @map("book_id")
  /// "ebook" | "audiobook"
  kind                 String
  /// wanted | downloading | downloaded | skipped | upgrading
  status               String  @default("wanted")
  monitored            Boolean @default(true)
  bookQualityProfileId Int?    @map("book_quality_profile_id")
  /// Audiobook only. Populated from container tags at import — Google Books
  /// exposes no narrator data.
  narrators            String[] @default([])
  /// Audiobook only. From MediaInfo at import.
  durationSecs         Int?     @map("duration_secs")
  searchAttempts        Int      @default(0) @map("search_attempts")
  /// Persisted MAX(download_history.grabbed_at); kept in sync by DB trigger.
  lastGrabbedAt        DateTime? @map("last_grabbed_at")
  /// Persisted SUM of book_file sizes; 0 stored as null. DB trigger.
  totalSizeBytes       BigInt?   @map("total_size_bytes")
  addedAt              DateTime  @default(now()) @map("added_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  book               LibraryBook         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookQualityProfile BookQualityProfile? @relation(fields: [bookQualityProfileId], references: [id], onDelete: SetNull)
  files              BookFile[]
  downloadHistories  DownloadHistory[]

  /// Exactly two possible rows per book: one ebook, one audiobook.
  @@unique([bookId, kind], map: "uq_book_editions_book_kind")
  @@index([status], map: "ix_book_editions_status")
  @@index([monitored], map: "ix_book_editions_monitored")
  @@index([bookQualityProfileId], map: "ix_book_editions_quality_profile_id")
  @@map("book_editions")
}

model BookFile {
  id           Int    @id @default(autoincrement())
  editionId    Int    @map("edition_id")
  filePath     String @map("file_path")
  fileName     String @map("file_name")
  sizeBytes    BigInt @map("size_bytes")
  /// epub|mobi|azw3|pdf|cbz | m4b|mp3|flac|ogg
  format       String
  durationSecs Float? @map("duration_secs")
  audioBitrate Int?   @map("audio_bitrate")
  audioCodec   String? @map("audio_codec")
  /// false means "unknown or scan", never "confirmed scan" — which is why
  /// there is no requireRetail profile field. Set from the release title at
  /// import; scan-discovered files have no release title to judge.
  isRetail     Boolean @default(false) @map("is_retail")
  releaseGroup String? @map("release_group")
  languageTags String[] @default([]) @map("language_tags")
  /// Filesystem identity + mtime, paired with sizeBytes to skip re-probing.
  fileDev      String? @map("file_dev")
  fileIno      String? @map("file_ino")
  fileMtimeMs  BigInt? @map("file_mtime_ms")
  scannedAt    DateTime @default(now()) @map("scanned_at")

  edition  BookEdition       @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId], map: "ix_book_files_edition_id")
  @@index([filePath], map: "ix_book_files_file_path")
  @@index([fileDev, fileIno], map: "ix_book_files_file_dev_ino")
  @@map("book_files")
}

/// Google Books exposes no author ids, so the name is the key. Homonymous
/// authors therefore collide; author monitoring is a convenience, not a
/// correctness-critical path.
model Author {
  id                   Int      @id @default(autoincrement())
  googleAuthorName     String   @unique @map("google_author_name")
  audibleAsin          String?  @unique @map("audible_asin")
  sortName             String?  @map("sort_name")
  imageUrl             String?  @map("image_url")
  bio                  String?
  monitored            Boolean  @default(false)
  monitorFrom          DateTime? @map("monitor_from")
  monitorEditionKinds  String[] @default([]) @map("monitor_edition_kinds")
  /// ISO 639-1. Which languages a new title has to be in to be added. Empty
  /// means any language — a book is one language (see LibraryBook.language),
  /// so following an author without this pulled every translation of a title.
  monitorLanguages     String[] @default([]) @map("monitor_languages")
  bookQualityProfileId Int?     @map("book_quality_profile_id")
  lastCheckedAt        DateTime? @map("last_checked_at")
  addedAt              DateTime @default(now()) @map("added_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  bookQualityProfile BookQualityProfile? @relation(fields: [bookQualityProfileId], references: [id], onDelete: SetNull)
  bookLinks          BookAuthor[]

  @@index([monitored], map: "ix_authors_monitored")
  @@map("authors")
}

model BookAuthor {
  id       Int    @id @default(autoincrement())
  authorId Int    @map("author_id")
  bookId   Int    @map("book_id")
  /// author | narrator | translator | illustrator.
  /// Only role = 'author' feeds LibraryBook.authors.
  role     String @default("author")

  author Author      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book   LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([authorId, bookId, role], map: "uq_book_authors_author_book_role")
  @@index([bookId], map: "ix_book_authors_book_id")
  @@map("book_authors")
}

/// Per-source identity. googleVolumeId stays on LibraryBook untouched, so no
/// existing query, trigger or unique constraint changes.
model BookExternalId {
  id         Int      @id @default(autoincrement())
  bookId     Int      @map("book_id")
  /// local | audnexus | googlebooks | openlibrary
  source     String
  externalId String   @map("external_id")
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  book LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, source], map: "uq_book_external_ids_book_source")
  @@index([source, externalId], map: "ix_book_external_ids_source_external")
  @@map("book_external_ids")
}

/// Which source won each field. Powers the provenance tooltip and tells a
/// refresh what is stale. A provider that raised
/// BookProviderUnavailableError writes NO row here — otherwise a transient 503
/// would read as "that source has no narrators for this book" forever.
model BookMetadataField {
  id        Int      @id @default(autoincrement())
  bookId    Int      @map("book_id")
  field     String
  source    String
  fetchedAt DateTime @default(now()) @map("fetched_at")

  book LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, field], map: "uq_book_metadata_fields_book_field")
  @@index([bookId], map: "ix_book_metadata_fields_book_id")
  @@map("book_metadata_fields")
}

/// Book equivalent of QualityProfile. Deliberately has no requireRetail:
/// real releases carry no retail marker, so requiring one rejects everything.
model BookQualityProfile {
  id                       Int      @id @default(autoincrement())
  name                     String   @unique
  /// "ebook" | "audiobook" | "both"
  kind                     String   @default("both")
  /// Ordered preference; first entry is best.
  allowedFormats           String[] @default([]) @map("allowed_formats")
  /// Stop upgrading once this format is reached.
  cutoffFormat             String?  @map("cutoff_format")
  preferRetail             Boolean  @default(true) @map("prefer_retail")
  maxSizeMb                Float?   @map("max_size_mb")
  minSeeders               Int      @default(0) @map("min_seeders")
  /// Audiobook only. Real releases of one title ranged 64 kb/s to 192 kbps.
  minAudioBitrate          Int?     @map("min_audio_bitrate")
  preferredLanguages       String[] @default([]) @map("preferred_languages")
  prioritizedTrackers      String[] @default([]) @map("prioritized_trackers")
  preferTrackerOverQuality Boolean  @default(false) @map("prefer_tracker_over_quality")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  editions      BookEdition[]
  authors       Author[]
  customFormats BookQualityProfileCustomFormat[]
  defaultForSettings MediaSettings[] @relation("DefaultBookQualityProfile")

  @@map("book_quality_profiles")
}

model BookQualityProfileCustomFormat {
  id                   Int     @id @default(autoincrement())
  bookQualityProfileId Int     @map("book_quality_profile_id")
  customFormatId       Int     @map("custom_format_id")
  score                Int     @default(0)
  required             Boolean @default(false)
  forbidden            Boolean @default(false)

  bookQualityProfile BookQualityProfile @relation(fields: [bookQualityProfileId], references: [id], onDelete: Cascade)
  customFormat       CustomFormat       @relation(fields: [customFormatId], references: [id], onDelete: Cascade)

  @@unique([bookQualityProfileId, customFormatId], map: "uq_bqp_custom_format")
  @@index([bookQualityProfileId], map: "ix_bqp_custom_format_profile")
  @@map("book_quality_profile_custom_formats")
}
