{
  // The Worker itself: typed with the runtime types `wrangler types` generates
  // for this compatibility date. Tests run under Bun and are checked separately.
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "lib": ["esnext"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src", "worker-configuration.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/testing.ts"]
}
